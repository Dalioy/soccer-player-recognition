# Python
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# OS
.DS_Store
**/.DS_Store

# Raw + processed data — not tracked, downloaded/scraped/generated by the pipeline
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Trained model + embeddings — regenerated by src/pipeline.py
models/*
!models/.gitkeep

# Generated evaluation outputs
outputs/figures/*
outputs/metrics/*
!outputs/figures/.gitkeep
!outputs/metrics/.gitkeep
